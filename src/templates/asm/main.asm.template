; {{name}} — Vector-06C assembly project
;
; Build:  make
; Run:    V6: Run Project (Ctrl+Shift+P)

; Sorting - Bubble Sort visualization for Vector-06c
; Fills a 256-byte array with pseudo-random values,
; then bubble sorts it, copying to 0xA000 after each pass.

            ARRAY_SIZE = 256
            ARRAY_ADDR = 0x4000
            DISPLAY_ADDR = 0x8000
            OPCODE_EI = 0xFB
            OPCODE_RET = 0xC9

.org 0x100
main:
			; Initialize registers to zero
			lxi sp, 0x8000
			lxi b, 0
			lxi d, 0
			lxi h, 0
			push b
			pop psw
			mvi a, OPCODE_EI
			sta 0x38
			mvi a, OPCODE_RET
			sta 0x39
			ei

	  		hlt
	  		call set_palette


start:
            ; Initialize stack
            lxi sp, 0x8000

            ; Set up interrupt handler (EI + RET at 0x38)
            mvi a, OPCODE_EI
            sta 0x38
            mvi a, OPCODE_RET
            sta 0x39
            ei

            ; Fill array with pseudo-random values
            call fill_random

            ; Copy initial unsorted array to display
            call copy_to_display

            ; Perform bubble sort
            call bubble_sort

            ; Done
            di
            hlt

; ---------------------------------------------------------
; fill_random - fills ARRAY_ADDR with 256 pseudo-random bytes
; Uses a simple linear congruential generator:
;   seed = seed * 13 + 37  (mod 256)
; ---------------------------------------------------------
fill_random:
            lxi h, ARRAY_ADDR      ; HL = destination pointer
            mvi b, 0                ; B = counter (256 iterations, wraps from 0)
            lda rng_seed            ; A = current seed
@loop:
            ; next = seed * 13 + 37
            mov c, a                ; save seed in C
            ; multiply by 13: x*13 = x*8 + x*4 + x
            ; x*2
            add a                   ; A = seed*2
            add a                   ; A = seed*4
            mov d, a                ; D = seed*4
            add a                   ; A = seed*8
            add d                   ; A = seed*8 + seed*4 = seed*12
            add c                   ; A = seed*12 + seed = seed*13
            adi 37                  ; A = seed*13 + 37
            mov m, a                ; store in array
            inr l                   ; next element (wraps at 256 boundary)
            dcr b
            jnz @loop
            sta rng_seed            ; save final seed
            ret

rng_seed:   .byte 0x7B              ; initial seed

; ---------------------------------------------------------
; copy_to_display - copies 256 bytes from ARRAY_ADDR to DISPLAY_ADDR
; ---------------------------------------------------------
copy_to_display:
            lxi h, ARRAY_ADDR
            lxi d, DISPLAY_ADDR
            mvi b, 0                ; 256 iterations
@loop:
            mov a, m                ; read source
            stax d                  ; write destination
            inr l                   ; next source
            inr e                   ; next destination
            dcr b
            jnz @loop
            ret

; ---------------------------------------------------------
; bubble_sort - sorts 256 bytes at ARRAY_ADDR in ascending order
; After each pass, copies the array to DISPLAY_ADDR
; ---------------------------------------------------------
bubble_sort:
@outer:
            mvi c, 0                ; C = swap flag (0 = no swaps)
            lxi h, ARRAY_ADDR      ; HL = pointer to first element
            mvi b, ARRAY_SIZE - 1   ; B = comparisons per pass (255)

@inner:
            mov a, m                ; A = array[i]
            inr l                   ; point to array[i+1]
            cmp m                   ; compare A with array[i+1]
            jc @no_swap             ; if array[i] < array[i+1], no swap
            jz @no_swap             ; if equal, no swap

            ; Swap array[i] and array[i+1]
            mov d, m                ; D = array[i+1]
            mov m, a                ; array[i+1] = array[i] (A still has old array[i])
            dcr l                   ; point back to array[i]
            mov m, d                ; array[i] = old array[i+1]
            inr l                   ; restore pointer to array[i+1]
            mvi c, 1                ; set swap flag

@no_swap:
            dcr b
            jnz @inner

            ; End of one pass - copy array to display address
            push b
            push psw
            call copy_to_display
            pop psw
            pop b

            ; Check if any swaps occurred
            mov a, c
            ora a
            jnz @outer              ; if swaps happened, do another pass

            ret

; ---------------------------------------------------------
; set_palette - loads 16 palette entries from the palette table
; ---------------------------------------------------------
PALETTE_LEN = 16
set_palette: ; non-local label
			lxi h, palette + PALETTE_LEN - 1
			mvi	a, 0x88
			out	0
			mvi	b, 0x0F

@loop: ; local label. can be reused if separated by non-local label
			mov	a, b
			out	2
			mov a, m
			out 0x0C
			push psw
			pop psw
			push psw
			pop psw
			dcx h
			dcr b
			out 0x0C

			jp	@loop
			ei
			ret
palette:
			DB b00_011_111, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, b00_000_000,
			DB b00_100_000, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27,
			DW 0b00_100_000, 0x21, $FFAA, 24, 025, %111, 0