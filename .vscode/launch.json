{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "preLaunchTask": "npm: compile",
      "env": {
        "VECTOR_PROFILE": "0",
        "VECTOR_PROFILE_RATE": "250"
      },
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/temp/project"
      ]
    }
  ]
}
