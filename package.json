{
  "name": "v6vscode",
  "displayName": "Vector-06c Development",
  "description": "Vector-06c development environment — project management, syntax highlighting, and emulator integration.",
  "version": "0.1.0",
  "publisher": "parallelno",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.project.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "v6.createProject",
        "title": "Create Project",
        "category": "V6"
      },
      {
        "command": "v6.runProject",
        "title": "Run Project",
        "category": "V6"
      }
    ],
    "languages": [
      {
        "id": "asm",
        "aliases": [
          "v6 asm 8080",
          "asm"
        ],
        "extensions": [
          ".asm",
          ".s",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asm",
        "scopeName": "source.v6vscode_8080",
        "path": "./res/syntaxes/v6vscode_8080.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "asm"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.block.v6vscode_8080",
            "settings": {
              "foreground": "#6A9955"
            }
          },
          {
            "scope": "keyword.globallabel.v6vscode_8080",
            "settings": {
              "foreground": "#e1e157"
            }
          },
          {
            "scope": "keyword.constantslabel.v6vscode_8080",
            "settings": {
              "foreground": "#8be0e9"
            }
          },
          {
            "scope": "entity.name.function.macro.v6vscode_8080",
            "settings": {
              "foreground": "#c67dc0"
            }
          },
          {
            "scope": "keyword.locallabel.v6vscode_8080",
            "settings": {
              "foreground": "#9d741c"
            }
          },
          {
            "scope": "keyword.instruction.v6vscode_8080",
            "settings": {
              "foreground": "#569cd6"
            }
          },
          {
            "scope": "keyword.control.flow.v6vscode_8080",
            "settings": {
              "foreground": "#20df8f"
            }
          },
          {
            "scope": "keyword.register.v6vscode_8080",
            "settings": {
              "foreground": "#59c979"
            }
          },
          {
            "scope": [
              "constant.numeric.binary.v6vscode_8080",
              "constant.numeric.hexadecimal.v6vscode_8080",
              "constant.numeric.octal.v6vscode_8080",
              "constant.numeric.decimal.v6vscode_8080"
            ],
            "settings": {
              "foreground": "#b5cea8"
            }
          }
        ]
      }
    },
    "configuration": {
      "title": "Vector-06c",
      "properties": {
        "v6.emulatorPath": {
          "type": "string",
          "default": "",
          "description": "Path to the v6emul binary. Checked before the V6EMUL environment variable and PATH."
        },
        "v6.assemblerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the v6asm executable. Checked before the V6ASM environment variable and PATH. Download from https://github.com/parallelno/v6asm/releases."
        },
        "v6.fddToolPath": {
          "type": "string",
          "default": "",
          "description": "Path to the v6fdd executable. Checked before the V6FDD environment variable and PATH. Download from https://github.com/parallelno/v6asm/releases."
        },
        "v6.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Logging verbosity for the V6 output channel."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.project.json",
        "url": "./config/schemas/v6.project.schema.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run test:unit",
    "test:unit": "mocha",
    "test:integration": "node ./node_modules/@vscode/test-electron/out/runTest.js",
    "test:regression": "mocha --no-config --require ./test/register.js --timeout 5000 'test/regression/**/*.test.ts'",
    "test:all": "npm run test:unit && npm run test:regression",
    "ci": "npm run compile && npm run lint && npm run test:all",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.7.1",
    "chai": "^4.4.1",
    "eslint": "^8.56.0",
    "mocha": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0-beta2"
  }
}
