{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "V6 Project",
  "description": "Vector-06c project configuration file.",
  "type": "object",
  "required": ["name", "run"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Project display name."
    },
    "run": {
      "type": "object",
      "required": ["executable"],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the ROM or FDD image to load."
        },
        "debugArtifact": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the companion ELF file containing debug metadata."
        },
        "loadAddr": {
          "type": "string",
          "pattern": "^(?:0[xX])?[0-9a-fA-F]{1,4}$",
          "default": "0x100",
          "description": "Load address for ROM images (hex string)."
        },
        "fddReadOnly": {
          "type": "boolean",
          "default": false,
          "description": "If true, discard FDD writes on stop."
        },
        "speed": {
          "type": "string",
          "enum": ["1%", "20%", "50%", "100%", "200%", "max"],
          "default": "100%",
          "description": "Emulation speed."
        },
        "viewMode": {
          "type": "string",
          "enum": ["borderless", "border", "full"],
          "default": "borderless",
          "description": "Display mode for the emulator panel."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
