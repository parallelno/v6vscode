# Source — compiled output in out/ is shipped instead
src/**
!src/emulator/panel/assets/**
!src/debug/views/assets/**

# Tests, design docs, temp files
test/**
design/**
temp/**
docs/**

# Config files not needed at runtime
tsconfig.json
tsconfig.test.json
.mocharc.yml
.eslintrc.json
.editorconfig

# Build and cache artifacts
**/*.log
**/*.map
.venv/
dist/
node_modules/.cache/
frames_out/

# Git and CI
.github/**
.gitignore